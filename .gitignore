# Godot 4+ specific ignores
.godot/
/android/

# ---------------------------------------------------------------------------
# Build 產物
# ---------------------------------------------------------------------------
/build/
*.apk
*.aab
*.apks
# Android 出貨產物。dist/ 入面淨係得 aab/apk + 佢哋嘅 SHA-256,全部由
# `tools/android_build.ps1` 重新出得返,冇一個係人手改過嘅。
/dist/

# ---------------------------------------------------------------------------
# 簽名材料 —— 呢一段係唯一一段「入咗 repo 就補救唔到」嘅規則
# ---------------------------------------------------------------------------
# upload keystore 同佢個密碼住喺 %USERPROFILE%\keystores\(即係 repo 以外),
# 所以正常情況下呢幾條規則永遠都唔會生效。佢哋喺度係做保險:任何人 copy 一份
# 落 project 資料夾嚟「方便啲」嘅時候,git 唔會幫佢哋將條 key 推上 GitHub。
#
# 一條 upload key 一旦公開就等於任何人都可以簽一個扮 Towerbound 嘅 update 上
# Play Console。詳情見 dist/KEYSTORE_BACKUP_README.md。
*.keystore
*.jks
*.credentials.env
*.credentials.txt

# Web export 掉咗喺 project root。出街嗰個 build 喺 /docs/ —— Web preset 以前
# 預設 ./index.html,每次唔寫明路徑就喺呢度留低一份 38 MB 嘅重複品。
/index.html
/index.js
/index.wasm
/index.pck
/index.png
/index.icon.png
/index.apple-touch-icon.png
/index.audio.worklet.js
/index.audio.position.worklet.js
/index.*.import
/index.side.wasm

# ---------------------------------------------------------------------------
# QA / bench 產物 —— 全部重新跑得返,所以一律唔入 repo
# ---------------------------------------------------------------------------
# 一條規則覆蓋晒將來所有輪次:art_export / heal_shots 都會將 `--out=` 拉入
# qa/screenshots/(見 tools/art_export.gd QA_ROOT),模擬同 log 落 qa/bench/。
# qa/.gdignore 令 Godot 連 import 都唔 import,所以呢啲檔案結構上入唔到 build
# —— 第九輪嗰次 50 MB QA 截圖被打包入 web build 嘅事故,唔會再靠人手維護排除表。
/qa/

# ---------------------------------------------------------------------------
# 本機執行產物
# ---------------------------------------------------------------------------
*.log
*.err

# 閃退證物。引擎同 Crash.gd 寫落 user://logs/(唔喺 project 入面),但如果有人
# 抄返落嚟分析,唔應該連埋入 repo。
/logs/
crash_*.txt
logcat*.txt

# i18n/*.csv 經 Godot importer 編譯出嚟嘅翻譯資源
*.translation

# 字型 subset 中間檔。tools/subset_font.py 直接寫最終
# assets/fonts/NotoSansTC-Subset.ttf(嗰個要入 repo),中間檔唔要。
*.subset.ttf
*.ttf.tmp
.fonttools_cache/

# 本機 editor / 工具狀態
.claude/settings.local.json
__pycache__/
*.pyc
