# Godot 4+ specific ignores
.godot/
/android/

# ---------------------------------------------------------------------------
# Build 產物
# ---------------------------------------------------------------------------
/build/
*.apk
*.aab

# Web export 掉咗喺 project root。出街嗰個 build 喺 /docs/ —— Web preset 以前
# 預設 ./index.html,每次唔寫明路徑就喺呢度留低一份 38 MB 嘅重複品。
/index.html
/index.js
/index.wasm
/index.pck
/index.png
/index.icon.png
/index.apple-touch-icon.png
/index.audio.worklet.js
/index.audio.position.worklet.js
/index.*.import
/index.side.wasm

# ---------------------------------------------------------------------------
# QA / bench 產物 —— 全部重新跑得返,所以一律唔入 repo
# ---------------------------------------------------------------------------
# 一條規則覆蓋晒將來所有輪次:art_export / heal_shots 都會將 `--out=` 拉入
# qa/screenshots/(見 tools/art_export.gd QA_ROOT),模擬同 log 落 qa/bench/。
# qa/.gdignore 令 Godot 連 import 都唔 import,所以呢啲檔案結構上入唔到 build
# —— 第九輪嗰次 50 MB QA 截圖被打包入 web build 嘅事故,唔會再靠人手維護排除表。
/qa/

# ---------------------------------------------------------------------------
# 本機執行產物
# ---------------------------------------------------------------------------
*.log
*.err

# 閃退證物。引擎同 Crash.gd 寫落 user://logs/(唔喺 project 入面),但如果有人
# 抄返落嚟分析,唔應該連埋入 repo。
/logs/
crash_*.txt
logcat*.txt

# i18n/*.csv 經 Godot importer 編譯出嚟嘅翻譯資源
*.translation

# 字型 subset 中間檔。tools/subset_font.py 直接寫最終
# assets/fonts/NotoSansTC-Subset.ttf(嗰個要入 repo),中間檔唔要。
*.subset.ttf
*.ttf.tmp
.fonttools_cache/

# 本機 editor / 工具狀態
.claude/settings.local.json
__pycache__/
*.pyc
