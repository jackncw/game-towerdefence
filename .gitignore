# Godot 4+ specific ignores
.godot/
/android/

# build artifacts (not needed for rollback)
/build/
*.apk
*.aab

# Web export dropped in the project root. The published build lives in /docs;
# the Web preset used to default to ./index.html and littered a 38 MB duplicate
# here every time it was exported without an explicit path.
/index.html
/index.js
/index.wasm
/index.pck
/index.png
/index.icon.png
/index.apple-touch-icon.png
/index.audio.worklet.js
/index.audio.position.worklet.js
/index.*.import
/index.side.wasm

# generated art exports / screenshots (re-renderable via tools/art_export.gd,
# tools/heal_shots.gd).
#
# 新嘅輸出全部落 /qa/ 之下 —— 兩個 exporter 都會將 --out= 拉入去(見
# tools/art_export.gd QA_ROOT)。咁樣 export_presets.cfg 個排除表就唔使再逐個
# 目錄名追:一條 `qa/*` 覆蓋晒將來所有輪次。下面嗰堆係歷史目錄,由
# `art_*` / `*_shots/*` 兩條 pattern 排除,留喺度淨係為咗本機仲有嗰幾份。
/qa/
/art_export/
/heal_shots/
/art_export_round6/
/art_i18n_zh/
/art_i18n_en/
/art_r8_zh/
/art_r8_en/
/art_r9/
/art_r9_en/
/Claude art self improve/

# translation resources compiled from i18n/*.csv by the Godot importer
*.translation

# run logs and profiling output
*.log

# local editor / tooling state
.claude/settings.local.json
__pycache__/
*.pyc
