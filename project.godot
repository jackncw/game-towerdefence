; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="塔防要塞 Tower Fortress"
run/main_scene="res://scenes/MainMenu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Crash="*res://scripts/autoload/Crash.gd"
GameData="*res://scripts/autoload/GameData.gd"
Assets="*res://scripts/autoload/Assets.gd"
Meta="*res://scripts/autoload/Meta.gd"
Flow="*res://scripts/autoload/Flow.gd"
Audio="*res://scripts/autoload/Audio.gd"
Web="*res://scripts/autoload/Web.gd"

[debug]

; 常設閃退記錄。呢個唔係 debug build 專用 —— 一單喺玩家機上面嘅閃退,如果冇
; 檔案 log 就只剩返一句「佢閃退咗」。log_path 同 Crash.gd 嘅 user://logs/ 同一
; 個資料夾,所以一單閃退嘅兩份證物(引擎 stack trace + 遊戲麵包屑)擺埋一齊。
file_logging/enable_file_logging=true
file_logging/log_path="user://logs/godot.log"
file_logging/max_log_files=10

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=486
window/size/window_height_override=864
window/stretch/mode="canvas_items"
; "keep", not "expand": the whole UI is laid out in absolute 1080x1920
; coordinates (nav bars pinned at y=1800, cards at fixed x), so an expanded
; viewport pushed those off the design rect. "keep" scales the 9:16 frame
; uniformly and letterboxes the remainder with default_clear_color, which is
; the only setting that cannot distort at any window aspect.
window/stretch/aspect="keep"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[internationalization]

locale/translations=PackedStringArray("res://i18n/game.en.translation", "res://i18n/game.zh_TW.translation")
locale/fallback="zh_TW"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
; Viewport clear colour, matched to UI.BG. NOTE: this is NOT the letterbox — the
; bars stretch/aspect=keep leaves are drawn black by the engine, outside the
; viewport, and there is no setting for them. This only matters if a screen ever
; fails to paint its own full-screen background, where warm dark beats Godot's
; default grey.
environment/defaults/default_clear_color=Color(0.11, 0.085, 0.065, 1)
rendering_device/driver.windows="d3d12"
textures/vram_compression/import_etc2_astc=true

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"
